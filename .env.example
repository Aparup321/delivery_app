# Fafo Delivery Partner App — environment template
#
# Copy this file to .env.local when setting up a Firebase project:
#   cp .env.example .env.local
#
# Never commit .env, .env.local or any other .env.* file — only this template is
# tracked. Real values belong in your local file or in the deployment provider's
# secret store, never in the repository.
#
# Vite only exposes variables prefixed with VITE_ to the browser. Firebase Web
# App configuration is public client configuration; service-account credentials,
# private keys and admin SDK secrets must never be added here. .env.local keeps
# these values out of Git, not out of the browser bundle.

# Firebase Web App configuration.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Future map provider (Phase 9/12) — unused while the route preview is a demo.
# VITE_MAP_PROVIDER_KEY=
