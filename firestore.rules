rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // delivery_admin signs in with this dedicated Firebase Auth account.
    // Replace the UID here if the admin account is recreated.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'Xa09IjoJrhPBvuJVWALOuCCHcvZ2';
    }

    // Shared string guard. Keeps a malicious or buggy client from writing an
    // unbounded document and every reader from rendering an enormous value.
    function maxText(value, limit) {
      return value is string && value.size() <= limit;
    }

    function validPartnerBank(bank) {
      return bank is map
        && bank.keys().hasOnly(['accountHolder', 'accountNumber', 'ifsc'])
        && maxText(bank.get('accountHolder', ''), 120)
        && maxText(bank.get('accountNumber', ''), 30)
        && maxText(bank.get('ifsc', ''), 11);
    }

    function validPartnerLatitude(value) {
      return value is number && value >= -90 && value <= 90;
    }

    function validPartnerLongitude(value) {
      return value is number && value >= -180 && value <= 180;
    }

    // Presence coordinates are the only nested partner-writable object on the
    // profile. Bound every member so a modified client cannot store large
    // blobs that the administrator console later renders.
    function validPartnerLocation(value) {
      return value == null || (
        value is map
        && value.keys().hasOnly([
          'latitude', 'longitude', 'accuracy', 'updatedAt'
        ])
        && validPartnerLatitude(value.get('latitude', 0))
        && validPartnerLongitude(value.get('longitude', 0))
        && (value.get('accuracy', null) == null
          || (value.get('accuracy', 0) is number
            && value.get('accuracy', 0) >= 0))
        && maxText(value.get('updatedAt', ''), 40)
      );
    }

    // Bounds the profile text a partner can write. A legitimate onboarding form
    // is far below these limits; the guard exists to stop storage abuse.
    function validPartnerData(data) {
      return (!data.keys().hasAny(['fullName'])
          || maxText(data.fullName, 120))
        && (!data.keys().hasAny(['email'])
          || maxText(data.email, 160))
        && (!data.keys().hasAny(['city'])
          || maxText(data.city, 80))
        && (!data.keys().hasAny(['addressLine'])
          || maxText(data.addressLine, 300))
        && (!data.keys().hasAny(['phone'])
          || maxText(data.phone, 20))
        && (!data.keys().hasAny(['authProvider'])
          || maxText(data.authProvider, 40))
        && (!data.keys().hasAny(['lastSignInAt'])
          || maxText(data.lastSignInAt, 40))
        && (!data.keys().hasAny(['profilePhotoUrl'])
          || data.profilePhotoUrl == null
          || maxText(data.profilePhotoUrl, 400000))
        && (!data.keys().hasAny(['profilePhotoPath'])
          || data.profilePhotoPath == null
          || maxText(data.profilePhotoPath, 512))
        && (!data.keys().hasAny(['pincode'])
          || (data.pincode is string
            && data.pincode.matches('^[0-9]{6}$')))
        && (!data.keys().hasAny(['dateOfBirth'])
          || data.dateOfBirth == null
          || maxText(data.dateOfBirth, 20))
        && (!data.keys().hasAny(['vehicleType'])
          || data.vehicleType == null
          || maxText(data.vehicleType, 20))
        && (!data.keys().hasAny(['joinedOn'])
          || data.joinedOn == null
          || maxText(data.joinedOn, 20))
        && (!data.keys().hasAny(['submittedAt'])
          || data.submittedAt == null
          || maxText(data.submittedAt, 40))
        && (!data.keys().hasAny(['updatedAt'])
          || data.updatedAt == null
          || maxText(data.updatedAt, 40))
        && (!data.keys().hasAny(['isOnline'])
          || data.isOnline is bool)
        && (!data.keys().hasAny(['availability'])
          || data.availability == null
          || maxText(data.availability, 20))
        && (!data.keys().hasAny(['lastLocationUpdatedAt'])
          || data.lastLocationUpdatedAt == null
          || maxText(data.lastLocationUpdatedAt, 40))
        && (!data.keys().hasAny(['presenceUpdatedAt'])
          || data.presenceUpdatedAt == null
          || maxText(data.presenceUpdatedAt, 40))
        && (!data.keys().hasAny(['lastLocation'])
          || validPartnerLocation(data.lastLocation))
        && (!data.keys().hasAny(['rating'])
          || data.rating == null
          || (data.rating is number
            && data.rating >= 0
            && data.rating <= 5))
        && (!data.keys().hasAny(['bank'])
          || data.bank == null
          || validPartnerBank(data.bank));
    }

    // Fields the partner app owns. Administrator decisions are deliberately
    // absent: status, applicationStatus, statusUpdatedAt, adminPartnerId,
    // adminReview and adminSuspension can only be written by delivery_admin.
    function partnerAppFields() {
      return [
        'partnerId', 'phone', 'authProvider', 'lastSignInAt', 'fullName',
        'email', 'dateOfBirth', 'profilePhotoUrl', 'profilePhotoPath',
        'city', 'addressLine', 'pincode', 'vehicleType', 'joinedOn',
        'submittedAt', 'updatedAt', 'bank', 'lastLocation',
        'lastLocationUpdatedAt', 'presenceUpdatedAt', 'isOnline', 'availability'
      ];
    }

    // A partner may add the lifecycle fields once: first submission, or a
    // re-application after a rejection. Nothing else may change them. `rating`
    // is deliberately absent: it is reputation data, not something a partner
    // may assign themselves.
    function submissionFields() {
      return [
        'partnerId', 'phone', 'authProvider', 'lastSignInAt', 'fullName',
        'email', 'dateOfBirth', 'profilePhotoUrl', 'profilePhotoPath',
        'city', 'addressLine', 'pincode', 'vehicleType',
        'joinedOn', 'submittedAt', 'updatedAt', 'bank', 'lastLocation',
        'lastLocationUpdatedAt', 'isOnline', 'status', 'applicationStatus',
        'statusUpdatedAt'
      ];
    }

    function isOwnerCreate(uid) {
      return request.resource.data.partnerId == uid
        && validPartnerData(request.resource.data)
        && request.resource.data.keys().hasOnly(submissionFields())
        && (!request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status == 'pending')
        && (!request.resource.data.keys().hasAny(['applicationStatus'])
          || request.resource.data.applicationStatus == 'submitted')
        && (!request.resource.data.keys().hasAny(['statusUpdatedAt'])
          || maxText(request.resource.data.statusUpdatedAt, 40))
        && !request.resource.data.keys().hasAny(
          ['adminReview', 'adminSuspension', 'adminPartnerId']);
    }

    // Presence is operational data, so it may only be published by an account
    // the Administrator has approved and left active. Going offline is always
    // allowed: the app forces suspended or unapproved accounts to offline and
    // must be able to record that without a permission error.
    function isApprovedAndActive() {
      return resource.data.get('applicationStatus', '') == 'approved'
        && resource.data.get('status', '') == 'active'
        && (!resource.data.keys().hasAny(['adminSuspension'])
          || resource.data.adminSuspension.active != true);
    }

    // One function for every partner-owned update. Profile/presence writes and
    // the one-way submission transition are the only allowed shapes, and
    // `validPartnerData` runs exactly once: evaluating it in two separate
    // branches doubles the expression count and pushes a full submission past
    // Firestore's per-request evaluation budget, which is reported to the app as
    // "Missing or insufficient permissions".
    function isOwnerUpdate(uid) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let previousStatus = resource.data.get('applicationStatus', '');
      let hasApplication = resource.data.keys().hasAny(['applicationStatus']);
      let canSubmit = previousStatus == null
        || previousStatus == ''
        || previousStatus in ['draft', 'rejected'];
      let isNotSuspended = !resource.data.keys().hasAny(['adminSuspension'])
        || resource.data.adminSuspension.active != true;
      let presenceChanged = changed.hasAny([
        'isOnline', 'availability', 'presenceUpdatedAt'
      ]);
      let locationChanged = changed.hasAny([
        'lastLocation', 'lastLocationUpdatedAt'
      ]);
      // Name, mobile, birth date and payout account are verified during review.
      // Once an application exists they are read-only; changes go through
      // support and the Administrator console.
      let verifiedChanged = changed.hasAny([
        'fullName', 'phone', 'dateOfBirth', 'bank'
      ]);

      return data.partnerId == uid
        && validPartnerData(data)
        && ((changed.hasOnly(partnerAppFields())
          && (!presenceChanged || data.isOnline != true || isApprovedAndActive())
          && (!locationChanged || isApprovedAndActive())
          && (!verifiedChanged || !hasApplication))
          || (canSubmit
            && isNotSuspended
            && data.applicationStatus == 'submitted'
            && data.status == 'pending'
            && maxText(data.statusUpdatedAt, 40)
            && changed.hasOnly(submissionFields())));
    }

    // KYC files can be corrected while an application is open, but not after
    // approval or while an Administrator has suspended the account.
    function applicationOpen(uid) {
      let partnerPath =
        /databases/$(database)/documents/partners/$(uid);

      return !exists(partnerPath)
        || (get(partnerPath).data.get('applicationStatus', '') != 'approved'
          && get(partnerPath).data.get('status', '') != 'paused');
    }

    match /partners/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || isOwnerCreate(uid);
      allow update: if isAdmin()
        || (isOwner(uid) && isOwnerUpdate(uid));
      allow delete: if isAdmin();
    }

    // delivery_admin's shared workflow document. Partner apps never read it.
    match /admin_state/{docId} {
      allow read, write: if isAdmin();
    }

    function partnerDocumentFields() {
      return ['partnerId', 'documentNumbers', 'documents', 'updatedAt'];
    }

    function validDocumentNumbers(value) {
      return value is map
        && value.keys().hasOnly([
          'aadhaar', 'pan', 'licence', 'registration', 'passbook'
        ])
        && maxText(value.get('aadhaar', ''), 40)
        && maxText(value.get('pan', ''), 40)
        && maxText(value.get('licence', ''), 40)
        && maxText(value.get('registration', ''), 40)
        && maxText(value.get('passbook', ''), 40);
    }

    function validStoredFile(value) {
      return value == null || (
        value is map
        && value.keys().hasOnly([
          'fileName', 'storagePath', 'downloadUrl', 'uploadedAt'
        ])
        && maxText(value.get('fileName', ''), 255)
        && (value.get('storagePath', null) == null
          || maxText(value.get('storagePath', ''), 512))
        && (value.get('downloadUrl', null) == null
          || maxText(value.get('downloadUrl', ''), 400000))
        && (value.get('uploadedAt', null) == null
          || maxText(value.get('uploadedAt', ''), 40))
      );
    }

    function validDocumentFiles(value) {
      return value is map
        && value.keys().hasOnly([
          'aadhaar', 'pan', 'licence', 'registration', 'passbook'
        ])
        && validStoredFile(value.get('aadhaar', null))
        && validStoredFile(value.get('pan', null))
        && validStoredFile(value.get('licence', null))
        && validStoredFile(value.get('registration', null))
        && validStoredFile(value.get('passbook', null));
    }

    function partnerDocumentPayload(data) {
      return data.partnerId is string
        && data.partnerId.size() <= 160
        && validDocumentNumbers(data.documentNumbers)
        && validDocumentFiles(data.documents)
        && maxText(data.updatedAt, 40);
    }

    // Partners own only the uploaded metadata. Administrator verification
    // lives under adminDocuments and must never be writable by the partner.
    match /partner_documents/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
      allow create: if isOwner(uid)
        && applicationOpen(uid)
        && request.resource.data.partnerId == uid
        && request.resource.data.keys().hasOnly(partnerDocumentFields())
        && partnerDocumentPayload(request.resource.data);
      allow update: if isOwner(uid)
        && applicationOpen(uid)
        && request.resource.data.partnerId == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(partnerDocumentFields())
        && partnerDocumentPayload(request.resource.data);
    }

    function vehiclePayload(data) {
      return data.partnerId is string
        && data.partnerId.size() <= 160
        && data.type in ['bike', 'scooter', 'bicycle', 'foot']
        && maxText(data.model, 120)
        && maxText(data.colour, 60)
        && maxText(data.registrationNumber, 40)
        && maxText(data.licenceNumber, 60)
        && maxText(data.updatedAt, 40);
    }

    match /vehicles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
      allow create: if isOwner(uid)
        && applicationOpen(uid)
        && request.resource.data.partnerId == uid
        && request.resource.data.keys().hasOnly([
          'partnerId', 'type', 'model', 'colour', 'registrationNumber',
          'licenceNumber', 'updatedAt'
        ])
        && vehiclePayload(request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.partnerId == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'partnerId', 'type', 'model', 'colour', 'registrationNumber',
            'licenceNumber', 'updatedAt'
          ])
        && vehiclePayload(request.resource.data)
        // After approval the partner may correct operational details, but the
        // verified licence number stays locked to its reviewed value.
        && (applicationOpen(uid)
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['licenceNumber']));
    }

    match /training_progress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
      allow create: if isOwner(uid)
        && applicationOpen(uid)
        && request.resource.data.keys().hasOnly([
          'partnerId', 'completed', 'completedCount', 'updatedAt'
        ])
        && request.resource.data.partnerId == uid
        && request.resource.data.completed is list
        && request.resource.data.completed.size() <= 20
        && request.resource.data.completedCount is int
        && request.resource.data.completedCount >= 0
        && request.resource.data.completedCount <= 20
        && request.resource.data.completedCount
          == request.resource.data.completed.size()
        && maxText(request.resource.data.updatedAt, 40);
      allow update: if isOwner(uid)
        && applicationOpen(uid)
        && request.resource.data.partnerId == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['completed', 'completedCount', 'updatedAt'])
        && request.resource.data.completed is list
        && request.resource.data.completed.size() <= 20
        && request.resource.data.completedCount is int
        && request.resource.data.completedCount >= 0
        && request.resource.data.completedCount <= 20
        && request.resource.data.completedCount
          == request.resource.data.completed.size()
        && maxText(request.resource.data.updatedAt, 40);
    }

    // Text-only in-app notification feed. The partner app writes the events it
    // derives from live delivery/account changes and only the owner can mark
    // them read. No media fields are allowed here.
    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (request.auth != null
          && resource.data.partnerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.partnerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'partnerUid', 'notificationId', 'type', 'title', 'body', 'vars',
          'createdAt', 'readAt', 'updatedAt'
        ])
        && request.resource.data.type in [
          'request', 'account', 'delivery'
        ]
        && maxText(request.resource.data.notificationId, 160)
        && maxText(request.resource.data.title, 160)
        && maxText(request.resource.data.body, 1000)
        && request.resource.data.vars is map
        && request.resource.data.vars.size() <= 20
        // Only the template variables the app actually renders are allowed, and
        // each one is length-bounded: the schema must not accept near-document
        // sized values that the console would later render.
        && request.resource.data.vars.keys().hasOnly([
          'id', 'category', 'pickup', 'drop', 'reason'
        ])
        && (!request.resource.data.vars.keys().hasAny(['id'])
          || maxText(request.resource.data.vars.get('id', ''), 160))
        && (!request.resource.data.vars.keys().hasAny(['category'])
          || maxText(request.resource.data.vars.get('category', ''), 80))
        && (!request.resource.data.vars.keys().hasAny(['pickup'])
          || maxText(request.resource.data.vars.get('pickup', ''), 160))
        && (!request.resource.data.vars.keys().hasAny(['drop'])
          || maxText(request.resource.data.vars.get('drop', ''), 160))
        && (!request.resource.data.vars.keys().hasAny(['reason'])
          || maxText(request.resource.data.vars.get('reason', ''), 400))
        && maxText(request.resource.data.createdAt, 40)
        && (request.resource.data.readAt == null
          || maxText(request.resource.data.readAt, 40))
        && maxText(request.resource.data.updatedAt, 40);
      allow update: if request.auth != null
        && resource.data.partnerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readAt', 'updatedAt'
        ])
        && (request.resource.data.readAt == null
          || maxText(request.resource.data.readAt, 40))
        && maxText(request.resource.data.updatedAt, 40);
      allow delete: if isAdmin()
        || (request.auth != null
          && resource.data.partnerUid == request.auth.uid);
    }

    // Payout requests. A partner creates their own `requested` row and reads
    // its status; only the administrator moves it to processing/paid/rejected.
    // The status list on the Earnings screen is an onSnapshot of these rows.
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (request.auth != null
          && resource.data.partnerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.partnerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'partnerUid', 'requestId', 'amount', 'upiId', 'status',
          'requestedAt', 'updatedAt'
        ])
        && request.resource.data.status == 'requested'
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() <= 160
        && request.resource.data.amount is number
        && request.resource.data.amount >= 1
        && request.resource.data.amount <= 1000000
        && request.resource.data.upiId is string
        && request.resource.data.upiId.matches(
          '^[A-Za-z0-9._-]{2,64}@[A-Za-z]{2,32}$')
        && maxText(request.resource.data.requestedAt, 40)
        && maxText(request.resource.data.updatedAt, 40);
      allow update, delete: if isAdmin();
    }

    // Partner-created support tickets are read by the owning partner and the
    // operations administrator. The admin console uses them for notifications.
    match /support_tickets/{ticketId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.partnerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.partnerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'partnerUid', 'id', 'subject', 'message', 'status', 'priority',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'Open'
        && (!request.resource.data.keys().hasAny(['priority'])
          || request.resource.data.priority in ['High', 'Normal'])
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 160
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 4
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 12
        && request.resource.data.message.size() <= 2000
        && maxText(request.resource.data.createdAt, 40)
        && maxText(request.resource.data.updatedAt, 40);
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.partnerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'subject', 'message', 'updatedAt'
          ])
          && request.resource.data.subject is string
          && request.resource.data.subject.size() >= 4
          && request.resource.data.subject.size() <= 120
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 12
          && request.resource.data.message.size() <= 2000
          && maxText(request.resource.data.updatedAt, 40));
      allow delete: if isAdmin();
    }

    function validDeliveryTransition(previous, next) {
      return next == previous
        || (previous == 'assigned' && next == 'accepted')
        || (previous == 'accepted'
          && next in ['pickup_arrived', 'cancelled'])
        || (previous == 'pickup_arrived'
          && next in ['picked_up', 'cancelled'])
        || (previous == 'picked_up'
          && next in ['in_transit', 'cancelled'])
        || (previous == 'in_transit'
          && next in ['drop_arrived', 'cancelled'])
        || (previous == 'drop_arrived'
          && next in ['delivered', 'cancelled']);
    }

    // Fields the assigned partner may change on a delivery. Everything the
    // Administrator controls — the route, customer data, payout, drop code and
    // the assignment itself — is deliberately absent, so the partner app can
    // advance a delivery but never rewrite one. `adminStatus` is present only
    // because the console renders it directly; validAdminStatus pins it to the
    // native status so it cannot carry invented workflow text.
    function partnerDeliveryFields() {
      return [
        'status', 'adminStatus', 'acceptedAt', 'completedAt',
        'cancellationReason', 'proof', 'events', 'currentLocation',
        'updatedAt', 'partnerResponse'
      ];
    }

    // Bounds the data the partner adds to a delivery. Route, customer data,
    // payout and the drop code stay Administrator-owned and are not here.
    function validLatitude(value) {
      return value is number && value >= -90 && value <= 90;
    }

    function validLongitude(value) {
      return value is number && value >= -180 && value <= 180;
    }

    function validDeliveryLocation(value) {
      return value == null || (
        value is map
        && value.keys().hasOnly([
          'latitude', 'longitude', 'accuracy', 'updatedAt'
        ])
        && validLatitude(value.get('latitude', 0))
        && validLongitude(value.get('longitude', 0))
        && (value.get('accuracy', null) == null
          || (value.get('accuracy', 0) is number
            && value.get('accuracy', 0) >= 0))
        && maxText(value.get('updatedAt', ''), 40)
      );
    }

    function validDeliveryProof(value) {
      return value == null || (
        value is map
        && value.keys().hasOnly([
          'method', 'verifiedAt', 'recipientName', 'note',
          'latitude', 'longitude', 'accuracy', 'demoOverride'
        ])
        && value.get('method', '') == 'otp'
        && maxText(value.get('verifiedAt', ''), 40)
        && (!value.keys().hasAny(['recipientName'])
          || maxText(value.recipientName, 80))
        && (!value.keys().hasAny(['note'])
          || maxText(value.note, 280))
        && (!value.keys().hasAny(['demoOverride'])
          || value.demoOverride is bool)
        && (!value.keys().hasAny(['latitude'])
          || validLatitude(value.latitude))
        && (!value.keys().hasAny(['longitude'])
          || validLongitude(value.longitude))
        && (!value.keys().hasAny(['accuracy'])
          || value.accuracy == null
          || (value.accuracy is number && value.accuracy >= 0))
      );
    }

    function validPartnerResponse(value) {
      return value == null || (
        value is map
        && value.keys().hasOnly(['decision', 'at', 'reason'])
        && value.get('decision', '') == 'rejected'
        && maxText(value.get('at', ''), 40)
        && (!value.keys().hasAny(['reason'])
          || maxText(value.reason, 160))
      );
    }

    // `adminStatus` mirrors delivery_admin's own workflow values. The partner is
    // allowed to keep it in step with the native status (the console renders it
    // directly), but only with the exact paired value: free text is not a
    // workflow the partner gets to invent.
    function validAdminStatus(status, adminStatus) {
      return (status == 'assigned' && adminStatus == 'Pending')
        || ((status == 'accepted' || status == 'pickup_arrived')
          && adminStatus == 'Assigned')
        || ((status == 'picked_up' || status == 'in_transit'
          || status == 'drop_arrived')
          && adminStatus == 'In Transit')
        || (status == 'delivered' && adminStatus == 'Completed')
        || (status == 'cancelled' && adminStatus == 'Cancelled');
    }

    // The events array is an append-only audit trail. Rules cannot iterate a
    // list, so the history length may only stay the same or grow by one, and
    // the appended entry must be the {status, at} pair for the requested status.
    function validDeliveryEvents(previous, next) {
      return next is list
        && next.size() <= 40
        && next.size() >= previous.size()
        && (next.size() == previous.size()
          || (next.size() == previous.size() + 1
            && next[next.size() - 1].keys().hasOnly(['status', 'at'])
            && next[next.size() - 1].status == request.resource.data.status
            && maxText(next[next.size() - 1].at, 40)));
    }

    function validPartnerDeliveryData(data) {
      return (!data.keys().hasAny(['cancellationReason'])
          || data.cancellationReason == null
          || maxText(data.cancellationReason, 200))
        && (!data.keys().hasAny(['partnerResponse'])
          || validPartnerResponse(data.partnerResponse))
        && (!data.keys().hasAny(['proof'])
          || validDeliveryProof(data.proof))
        && (!data.keys().hasAny(['currentLocation'])
          || validDeliveryLocation(data.currentLocation))
        && (!data.keys().hasAny(['acceptedAt'])
          || data.acceptedAt == null
          || maxText(data.acceptedAt, 40))
        && (!data.keys().hasAny(['completedAt'])
          || data.completedAt == null
          || maxText(data.completedAt, 40))
        && (!data.keys().hasAny(['updatedAt'])
          || data.updatedAt == null
          || maxText(data.updatedAt, 40))
        && (data.get('proof', null) == null || data.status == 'delivered');
    }

    // Offers are created by the Administrator console (status 'assigned', with
    // partnerUid set to the intended partner). The assigned partner reads and
    // advances their own delivery; a partner can never create, reassign or
    // rewrite one. Status changes follow validDeliveryTransition only.
    match /deliveries/{deliveryId} {
      allow read: if isAdmin()
        || (request.auth != null
          && resource.data.partnerUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.partnerUid == request.auth.uid
          // Delivered/cancelled evidence is immutable to the partner.
          && resource.data.status != 'delivered'
          && resource.data.status != 'cancelled'
          && validPartnerDeliveryData(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(partnerDeliveryFields())
          && validDeliveryEvents(
            resource.data.get('events', []),
            request.resource.data.get('events', []))
          && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['adminStatus'])
            || validAdminStatus(
              request.resource.data.status,
              request.resource.data.adminStatus))
          && validDeliveryTransition(
            resource.data.status,
            request.resource.data.status));
      allow delete: if isAdmin();
    }
  }
}
